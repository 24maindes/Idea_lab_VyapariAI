# Copy this file to .env and fill in your own values. NEVER commit .env to git.
DATABASE_URL=sqlite:///./vyapariai.db
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI advisor (Google Gemini). Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Model name, for example a Gemini Flash model. Check the current names in Google AI Studio.
GEMINI_MODEL=
